# --- HÀM QUẢN LÝ DỮ LIỆU ---
def load_rooms():
  if os.path.exists(ROOMS_FILE):
    try:
      with open(ROOMS_FILE, "r", encoding="utf-8") as f:
        return json.load(f)
    except:
      return {}
  return {}


def save_rooms(rooms):
  with open(ROOMS_FILE, "w", encoding="utf-8") as f:
    json.dump(rooms, f, ensure_ascii=False, indent=4)


@st.cache_data
def load_questions_data():
  try:
    with open("questions.json", "r", encoding="utf-8") as f:
      return json.load(f)
  except:
    return {
        "version": "2.2.0",
        "cards": [{
            "id": "0",
            "group": "Mặc định",
            "question": "Dữ liệu đang tải...",
            "options": ["A"],
            "answer": "A",
            "explanation": "Lỗi",
        }],
    }


q_data = load_questions_data()

# --- KHỞI TẠO SESSION ---
if "activated" not in st.session_state:
  st.session_state.activated = False
if "serial_used" not in st.session_state:
  st.session_state.serial_used = ""
if "joined_room" not in st.session_state:
  st.session_state.joined_room = None
if "my_role" not in st.session_state:
  st.session_state.my_role = None
if "player_name" not in st.session_state:
  st.session_state.player_name = ""


# ==========================================
# 1. BƯỚC XÁC THỰC BẢN QUYỀN
# ==========================================
if not st.session_state.activated:
  st.markdown(
      '<div class="main-header">🧠 CHẠM – Cổng Xác Thực Bản Quyền Board'
      " Game</div>",
      unsafe_allow_html=True,
  )
  st.markdown(
      '<div class="sub-header">Nhập mã sê-ri đi kèm hộp board game vật lý để'
      " kích hoạt hệ thống</div>",
      unsafe_allow_html=True,
  )

  col1, col2 = st.columns([2, 1])
  with col1:
    input_serial = st.text_input(
        "Nhập mã sê-ri / mã kích hoạt:", placeholder="Ví dụ: CHAM-2026-PRO"
    )

    c_btn1, c_btn2 = st.columns(2)
    with c_btn1:
      if st.button(
          "Kích hoạt bản quyền", type="primary", use_container_width=True
      ):
        clean_serial = input_serial.strip().upper()
        if clean_serial in VALID_SERIAL_CODES:
          st.session_state.activated = True
          st.session_state.serial_used = clean_serial
          st.success("Kích hoạt thành công!")
          st.rerun()
        else:
          st.error("Mã sê-ri không hợp lệ. Hãy thử dùng mã Demo bên dưới.")
    with c_btn2:
      if st.button("Dùng thử nhanh (Mã Demo)", use_container_width=True):
        st.session_state.activated = True
        st.session_state.serial_used = "CHV-10S-DEMO"
        st.warning("Đang vào chế độ Demo trực tuyến.")
        st.rerun()
  st.stop()


# ==========================================
# 2. SẢNH CHỜ & TẠO PHÒNG
# ==========================================
if not st.session_state.joined_room:
  st.markdown(
      '<div class="main-header">🧠 CHẠM – Hệ Thống Ván Đấu Trực Tuyến</div>',
      unsafe_allow_html=True,
  )
  st.markdown(
      f'<div class="sub-header">Trạng thái: Đã xác thực (<code>{st.session_state.serial_used}</code>)</div>',
      unsafe_allow_html=True,
  )

  col_l1, col_l2 = st.columns(2)

  with col_l1:
    st.subheader("🏠 Tạo Phòng Ván Đấu Mới")
    creator_name = st.text_input(
        "Tên người chơi (Host):", placeholder="Ví dụ: Gia An"
    )
    custom_room = st.text_input(
        "Mã phòng (để trống sẽ tự sinh):", placeholder="Ví dụ: CHAM64"
    )

    if st.button("Tạo Phòng Mới", type="primary"):
      if not creator_name.strip():
        st.error("Vui lòng nhập tên của bạn!")
      else:
        rooms = load_rooms()
        code = (
            custom_room.strip().upper()
            if custom_room.strip()
            else f"CHAM{random.randint(100, 999)}"
        )
        rooms[code] = {
            "host": creator_name,
            "players": {
                "Nghiên cứu (Research)": creator_name,
                "Công nghệ (Tech)": "",
                "Chăm sóc (Care)": "",
                "Cộng đồng (Community)": "",
            },
            "positions": {
                "Nghiên cứu (Research)": 1,
                "Công nghệ (Tech)": 1,
                "Chăm sóc (Care)": 1,
                "Cộng đồng (Community)": 1,
            },
            "indicators": {
                "Nghiên cứu": 4,
                "Công nghệ": 4,
                "Chăm sóc": 4,
                "Cộng đồng": 4,
                "Gánh nặng": 2,
            },
            "turn_order": [
                "Nghiên cứu (Research)",
                "Công nghệ (Tech)",
                "Chăm sóc (Care)",
                "Cộng đồng (Community)",
            ],
            "current_turn_idx": 0,
            "current_card": None,
            "card_status": "WAITING",
            "game_started": False,
            "logs": [f"Phòng {code} khởi tạo thành công bởi {creator_name}."],
        }
        save_rooms(rooms)
        st.session_state.joined_room = code
        st.session_state.my_role = "Nghiên cứu (Research)"
        st.session_state.player_name = creator_name
        st.success("Tạo phòng thành công!")
        st.rerun()

  with col_l2:
    st.subheader("🔑 Tham Gia Phòng Đã Tạo")
    join_name = st.text_input("Tên của bạn:", placeholder="Ví dụ: Minh Quân")
    join_code = st.text_input(
        "Mã phòng trực tuyến:", placeholder="Ví dụ: CHAM64"
    ).upper()

    rooms = load_rooms()
    available_roles = []
    if join_code in rooms:
      available_roles = [
          role
          for role, pname in rooms[join_code]["players"].items()
          if pname == ""
      ]

    chosen_role = st.selectbox(
        "Chọn vai trò trụ cột của bạn[cite: 51]:",
        available_roles if available_roles else ["Nghiên cứu (Research)"],
    )

    if st.button("Vào Phòng Chơi", type="secondary"):
      if not join_name.strip():
        st.error("Vui lòng nhập tên của bạn!")
      elif join_code not in rooms:
        st.error("Không tìm thấy mã phòng này!")
      else:
        rooms = load_rooms()
        rooms[join_code]["players"][chosen_role] = join_name
        rooms[join_code]["logs"].append(
            f"{join_name} đã gia nhập trụ cột {chosen_role}."
        )
        save_rooms(rooms)

        st.session_state.joined_room = join_code
        st.session_state.my_role = chosen_role
        st.session_state.player_name = join_name
        st.success("Vào phòng thành công!")
        st.rerun()

  st.stop()


# ==========================================
# 3. BÀN CHƠI CHÍNH & MÔ PHỎNG BẢN ĐỒ 64 Ô
# ==========================================
code = st.session_state.joined_room
rooms = load_rooms()

if code not in rooms:
  st.error("Phòng chơi đã bị đóng!")
  if st.button("Quay lại sảnh"):
    st.session_state.joined_room = None
    st.rerun()
  st.stop()

room = rooms[code]

c_h1, c_h2, c_h3 = st.columns([3, 1, 1])
with c_h1:
  st.markdown(
      f"### 🧠 Phòng: `{code}` | Trụ cột của bạn: **{st.session_state.my_role}**"
      f" ({st.session_state.player_name})"
  )
with c_h2:
  if st.button("🔄 Đồng bộ dữ liệu", use_container_width=True):
    st.rerun()
with c_h3:
  if st.button("🚪 Rời phòng", use_container_width=True):
    st.session_state.joined_room = None
    st.rerun()

st.markdown("---")

# Sảnh chờ playtest nhanh
if not room["game_started"]:
  st.subheader("👥 Sảnh Chờ (Playtest Mode)")
  for role, pname in room["players"].items():
    status = f"✅ **{pname}**" if pname else "⏳ *(Trống)*"
    st.markdown(f"- **{role}**: {status}")

  if st.button(
      "🚀 BẮT ĐẦU VÁN CHƠI NGAY (PLAYTEST)",
      type="primary",
      use_container_width=True,
  ):
    room["game_started"] = True
    for r_key in room["players"]:
      if not room["players"][r_key]:
        room["players"][r_key] = f"Bot ({r_key.split()[0]})"
    room["logs"].append(
        "Ván chơi đã bắt đầu với bàn đồ 64 ô tự động hóa."
    )
    save_rooms(rooms)
    st.rerun()
  st.stop()


# --- GIAO DIỆN BÀN CHƠI CHÍNH ---
col_map, col_ctrl = st.columns([1.7, 1])

current_turn_role = room["turn_order"][room["current_turn_idx"]]
is_my_turn = current_turn_role == st.session_state.my_role

with col_map:
  st.subheader("🗺️ Trạng Thái Bản Đồ 64 Ô (Phong Cách Cờ Tỷ Phú)")

  # Hiển thị vị trí nhân vật trên bàn cờ
  pos_cols = st.columns(4)
  for idx, (role, pos) in enumerate(room["positions"].items()):
    cell_info = BOARD_CELLS.get(pos, {"name": "Đang di chuyển"})
    with pos_cols[idx]:
      st.markdown(
          f"""
            <div class="cell-box">
                <b>{role.split()[0]}</b><br>
                📍 Ô {pos}/64<br>
                <span style="color: #2980b9;">{cell_info['name']}</span>
            </div>
            """,
          unsafe_allow_html=True,
      )

  st.markdown("---")
  st.subheader("📊 Các Chỉ Số Hệ Sinh Thái (0 - 10)")
  ind_cols = st.columns(5)
  for i, (k, val) in enumerate(room["indicators"].items()):
    with ind_cols[i]:
      st.metric(label=k, value=f"{val}")

  st.markdown("---")
  st.subheader("📜 Nhật Ký Hoạt Động Tự Động")
  log_container = st.container()
  with log_container:
    st.markdown('<div class="system-log">', unsafe_allow_html=True)
    for log in reversed(room["logs"][-8:]):
      st.text(f">> {log}")
    st.markdown("</div>", unsafe_allow_html=True)

with col_ctrl:
  st.subheader("⚙️ Bảng Điều Phối Lượt Đi")
  st.info(f"🎯 Lượt hiện tại: **{current_turn_role}")

  if is_my_turn or st.session_state.player_name == room["host"]:
    if is_my_turn:
      st.success("✨ Đến lượt nhân vật của bạn!")
    else:
      st.warning("⚠️ [Quản trị viên] Bạn đang thao tác quyền Host.")

    # Bước 1: Tung xúc xắc di chuyển trên bàn cờ 64 ô
    if room["current_card"] is None:
      if st.button(
          "🎲 Tung Xúc Xắc (1-6 bước)", type="primary", use_container_width=True
      ):
        steps = random.randint(1, 6)
        old_pos = room["positions"][current_turn_role]
        new_pos = min(64, old_pos + steps)
        room["positions"][current_turn_role] = new_pos

        # Lấy thông tin ô mà nhân vật vừa đặt chân đến
        landed_cell = BOARD_CELLS.get(new_pos, {"group": "Kiến thức (KT)"})
        cell_group_type = landed_cell["group"]

        # Lọc kho thẻ tương ứng với loại ô trên bàn cờ
        matching_cards = [
            c
            for c in q_data["cards"]
            if cell_group_type.split()[0] in c["group"]
        ]
        if not matching_cards:
          matching_cards = q_data["cards"]  # Fallback nếu chưa đủ thẻ nhóm đó

        card = random.choice(matching_cards)
        room["current_card"] = card
        room["card_status"] = "WAITING"

        room["logs"].append(
            f"{current_turn_role} tung được {steps} bước, đến ô số {new_pos}"
            f" ({landed_cell['name']}) -> Kích hoạt thẻ {card['id']}."
        )
        save_rooms(rooms)
        st.rerun()

    # Bước 2: Hiển thị thẻ tự động bốc dựa vào ô đất
    if room["current_card"] is not None:
      card = room["current_card"]
      current_pos = room["positions"][current_turn_role]
      cell_info = BOARD_CELLS.get(current_pos, {})

      st.markdown('<div class="card-box">', unsafe_allow_html=True)
      st.markdown(
          f'<span class="badge">Ô số {current_pos}: {cell_info.get("name", "")}'
          f" | Thẻ {card['id']}</span>",
          unsafe_allow_html=True,
      )
      st.markdown(f"")

      user_ans = st.radio(
          "Hệ thống phán quyết trắc nghiệm:",
          card["options"],
          key="board_ans_sel",
      )

      if room["card_status"] == "WAITING":
        if st.button("Xác nhận & Phán quyết tự động"):
          room["card_status"] = "ANSWERED"
          if user_ans == card["answer"]:
            room["indicators"]["Nghiên cứu"] = min(
                10, room["indicators"]["Nghiên cứu"] + 1
            )
            room["logs"].append(
                "Phán quyết: CHÍNH XÁC! Tự động cộng +1 điểm Nghiên cứu."
            )
          else:
            room["indicators"]["Gánh nặng"] = min(
                10, room["indicators"]["Gánh nặng"] + 1
            )
            room["logs"].append(
                "Phán quyết: CHƯA ĐÚNG. Tự động tăng +1 Gánh nặng xã hội."
            )
          save_rooms(rooms)
          st.rerun()
      else:
        st.success(f"📌 Đáp án chuẩn: **")
        st.info(f"💡 Giải thích chuyên môn: {card['explanation']}")

        if st.button(
            "➡️ Hoàn tất lượt & Chuyển người tiếp theo",
            type="primary",
            use_container_width=True,
        ):
          room["current_turn_idx"] = (room["current_turn_idx"] + 1) % 4
          room["current_card"] = None
          room["card_status"] = "WAITING"
          room["logs"].append(
              "Đã kết thúc lượt, chuyển sang người chơi tiếp theo."
          )
          save_rooms(rooms)
          st.rerun()

      st.markdown("</div>", unsafe_allow_html=True)

  else:
    st.warning(f"Đang chờ lượt đi của **{current_turn_role}**...")
